# Image service of the claim form (app.py): YOLOv8 proposal + similar-photo search.
# CPU only. The weights (best.pt) and the similar-photo index (index/) are mounted from the host by docker-compose, so that
# auto_retrain.py (which replaces best.pt and calls POST /reload) and index_reclamations.py keep working without a rebuild.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir --default-timeout=180 --retries 8 torch torchvision --index-url https://download.pytorch.org/whl/cpu
COPY requirements-cv.txt .
RUN pip install --no-cache-dir --default-timeout=180 --retries 8 -r requirements-cv.txt requests
COPY app.py embeddings.py cv_mapping.py defect_catalog.json cv_class_map.json index_reclamations.py ./
ENV CV_MODEL_PATH=/app/best.pt CV_SIMILAR_INDEX=/app/index YOLO_CONFIG_DIR=/tmp/ultralytics
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=10s --retries=3 CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:5000/health',timeout=8)"
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "5000"]
