# Copy this file to .env (it is ignored by git) and fill it in.

# SQL Server administrator password: at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=

# Passwords of the two accounts created at first start on an EMPTY database (superadmin@coficab.com and admin@coficab.com).
# Not needed when the database already holds them. In Production, an empty value skips the account.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# Address the browser uses to reach the APIs. localhost for a demo on this machine; on a server, its DNS name.
PUBLIC_HOST=localhost

# Optional
# SQL Server image. 2019 is the default. To use SQL Server 2022 instead, uncomment the next line:
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# ML_DATASET_KEY=
# GEMINI_API_KEY=
# SEMANTIC_BACKFILL=true
# ML_PORT=8001   (host port of the ML service; change it if 8001 is already taken)
