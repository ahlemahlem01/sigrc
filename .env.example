# Copy this file to .env (it is ignored by git) and fill it in.

# SQL Server administrator password: at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=

# Passwords of the two accounts created at first start on an EMPTY database (superadmin@coficab.com and admin@coficab.com).
# Not needed when the database already holds them. In Production, an empty value skips the account.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# Address the browser uses to reach the APIs. localhost for a demo on this machine; on a server, its DNS name.
PUBLIC_HOST=localhost

# Optional
# SQL Server image. 2019 is the default. To use SQL Server 2022 instead, uncomment the next line:
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# ML_DATASET_KEY=
# GEMINI_API_KEY=
# SEMANTIC_BACKFILL=true
# ML_PORT=8001   (host port of the ML service; change it if 8001 is already taken)
# CV_SERVICE_URL=http://host.docker.internal:5000   (image service started on this machine: ml-service/app.py, port 5000)
# CV_MODE=demo   (fixed example proposals, see scripts/demo-cv.ps1)
# Gemini model used by the quality assistant and the AI suggestions (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# AI provider: gemini (default) or ollama (local server installed on this machine, https://ollama.com).
# With ollama, GEMINI_API_KEY becomes optional and acts as the fallback when Ollama does not answer.
# Models to pull once: ollama pull qwen2.5:3b ; ollama pull qwen2.5vl:3b ; ollama pull nomic-embed-text
# After the first switch, the search embeddings are recomputed by the backfill (SEMANTIC_BACKFILL=true).
# LLM_PROVIDER=ollama
# LLM_VISION_PROVIDER=gemini   (photos stay on Gemini when a key is set; "ollama" also sends them to the local vision model, much less reliable)
# LLM_COACH_PROVIDER=gemini   (the 5 Why coach stays on Gemini when a key is set; "ollama" moves it to the local model, less strict)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
