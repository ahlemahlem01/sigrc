# Action Plan API. Build context is the Coficab.Auth folder.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY Coficab.ActionPlan.Core/Coficab.ActionPlan.Core.csproj Coficab.ActionPlan.Core/
COPY Coficab.ActionPlan.Application/Coficab.ActionPlan.Application.csproj Coficab.ActionPlan.Application/
COPY Coficab.ActionPlan.Infrastructure/Coficab.ActionPlan.Infrastructure.csproj Coficab.ActionPlan.Infrastructure/
COPY Coficab.Auth.API/Coficab.Auth.API.csproj Coficab.Auth.API/
COPY Coficab.ActionPlan.API/Coficab.ActionPlan.API.csproj Coficab.ActionPlan.API/
RUN dotnet restore Coficab.ActionPlan.API/Coficab.ActionPlan.API.csproj
COPY Coficab.ActionPlan.Core/ Coficab.ActionPlan.Core/
COPY Coficab.ActionPlan.Application/ Coficab.ActionPlan.Application/
COPY Coficab.ActionPlan.Infrastructure/ Coficab.ActionPlan.Infrastructure/
COPY Coficab.Auth.API/ Coficab.Auth.API/
COPY Coficab.ActionPlan.API/ Coficab.ActionPlan.API/
RUN dotnet publish Coficab.ActionPlan.API/Coficab.ActionPlan.API.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Production
COPY --from=build /app .
EXPOSE 8080
CMD ["sh", "-c", "dotnet Coficab.ActionPlan.API.dll --urls http://0.0.0.0:${PORT:-8080}"]
